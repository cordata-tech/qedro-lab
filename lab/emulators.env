# Endpoints and credentials for the emulators, read by the emitters' transports
# and by qedro's readers. Every value is a published emulator default or a
# placeholder; none is a secret, and none works against a real cloud.

OPENLINEAGE_CONFIG=/lab/openlineage.yml

# S3, through moto. botocore reads AWS_ENDPOINT_URL, so qedro's s3fs reader
# reaches the emulator with no option of qedro's own.
AWS_ENDPOINT_URL=http://s3:5000
AWS_ACCESS_KEY_ID=lab
AWS_SECRET_ACCESS_KEY=lab
AWS_REGION=eu-central-1

# GCS, through fake-gcs-server. gcsfs reads STORAGE_EMULATOR_HOST.
STORAGE_EMULATOR_HOST=http://gcs:4443
# gcsfs 2026.10 defaults this to true and then asks each bucket its type over
# gRPC, which fake-gcs-server does not speak in plain-HTTP mode: every write
# waited 60s for the probe to time out before falling back. Real GCS answers it.
GCSFS_EXPERIMENTAL_ZB_HNS_SUPPORT=false

# Azure Blob, through Azurite's published development account.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azure:10000/devstoreaccount1;
AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1

KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=openlineage.events
